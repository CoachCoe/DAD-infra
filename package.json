{
  "name": "dad-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Shared AWS CDK (TypeScript) IaC estate for DAD (us-east-2, staging + production). One CDK app per tenant.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1146.1",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
